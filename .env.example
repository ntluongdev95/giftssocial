
# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development

# ── Auth / JWT ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Google OAuth ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database — PostgreSQL (required) ─────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/gao_social

# ── Database — Redis (sessions, cache, pub/sub) ─────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage — Cloudflare R2 (leave empty for local dev uploads) ──────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gao-social-uploads
R2_PUBLIC_URL=

# ── Maps — MapTiler ──────────────────────────────────────────────────
# Get free key: https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=

# ── Gao Platform APIs ────────────────────────────────────────────────
NEXT_PUBLIC_DOMAIN_API_URL=
NEXT_PUBLIC_NOTI_API_URL=

# ── WebSocket (real-time) ────────────────────────────────────────────
NEXT_PUBLIC_WS_URL=

# ── Firebase (push notifications) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Gao ID (canonical identity layer) ────────────────────────────────
# Issuer + audience for the Gao ID Worker. Dev tier currently uses the
# TEST issuer (id-dev.gao.domains is not deployed). See
# docs/social-web-gao-id-auth-plan.md for tier topology.
NEXT_PUBLIC_GAO_ID_API=https://id-test.gao.domains
NEXT_PUBLIC_GAO_ID_AUDIENCE=https://api-test.gao.domains
# SIWE message `domain` field — must match the gao-id-worker SIWE_DOMAIN
# allowlist. For app-dev.gao.social this is the bare host (no scheme).
NEXT_PUBLIC_GAO_ID_SIWE_DOMAIN=app-dev.gao.social
# Master kill-switch for the Gao ID layer. Phase 2a default is "false";
# bootstrap (Google/Apple) login behavior is unchanged when off.
NEXT_PUBLIC_GAO_ID_ENABLED=false
# Reown / WalletConnect canonical Gao project ID. Never hardcode a
# fallback — empty + flag-off is the correct dev default.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Feature Flags ────────────────────────────────────────────────────
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_KYC_ENABLED=false
NEXT_PUBLIC_KYB_ENABLED=false
