{
  "name": "gao-social-v3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview:dev": "wrangler dev --env dev",
    "cf:deploy:dev": "wrangler deploy --env dev",
    "db:init:local": "wrangler d1 execute gao-social-dev --local --file=schema-d1.sql",
    "db:seed:local": "wrangler d1 execute gao-social-dev --local --file=src/db/seed-local.sql && wrangler d1 execute gao-social-dev --local --file=src/db/seed-users-vn.sql && wrangler d1 execute gao-social-dev --local --file=src/db/seed-biz-events-vn.sql",
    "db:reset:local": "npm run db:init:local && npm run db:seed:local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@opennextjs/cloudflare": "^1.18.0",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@tanstack/react-query": "^5.100.9",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.183.1",
    "@wagmi/core": "^3.4.8",
    "axios": "^1.14.0",
    "date-fns": "^4.1.0",
    "esbuild": "^0.28.0",
    "firebase": "^12.11.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.2",
    "json-bigint": "^1.0.0",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^5.21.1",
    "next": "16.2.1",
    "next-pwa": "^5.6.0",
    "ngeohash": "^0.6.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "siwe": "^3.0.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "three": "^0.183.2",
    "type-fest": "^5.5.0",
    "viem": "^2.48.11",
    "wagmi": "^3.6.11",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.1",
    "@tailwindcss/postcss": "^4",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.79.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.2.2",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-arm64-gnu": "1.32.0",
    "@ast-grep/napi-linux-x64-gnu": "0.40.5",
    "@ast-grep/napi-linux-arm64-gnu": "0.40.5",
    "@next/swc-linux-x64-gnu": "16.2.1",
    "@next/swc-linux-arm64-gnu": "16.2.1",
    "@unrs/resolver-binding-linux-x64-gnu": "1.11.1",
    "@unrs/resolver-binding-linux-arm64-gnu": "1.11.1"
  }
}
